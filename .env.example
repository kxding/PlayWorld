# Copy this file to your shell environment; the code does not read .env files
# automatically and never stores a credential in run artifacts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
# Optional gateway root URL. Leave empty for the public Gemini API.
GEMINI_BASE_URL=
# Optional JSON headers for an authorized gateway. Never commit real values.
GEMINI_HEADERS_JSON={}
